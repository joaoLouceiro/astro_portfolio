---
// Root page: client-side browser-language redirect (static + noscript fallback).
---

<html lang="pt">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>jlouceiro</title>
  </head>
  <body>
    <script is:inline>
      const supported = ["pt", "en"];
      const langs = (navigator.languages ?? [navigator.language]).map((l) =>
        l.toLowerCase().split("-")[0],
      );
      const pick = langs.find((l) => supported.includes(l)) ?? "pt";
      window.location.replace("/" + pick + "/");
    </script>
    <noscript>
      <meta http-equiv="refresh" content="0;url=/pt/" />
    </noscript>
  </body>
</html>