---
import BaseLayout from "./BaseLayout.astro";
import Tags from "../components/Tags.astro";
import "../styles/global.css";
import ArrowLeft from "../assets/arrow-left.svg";
import ArrowRight from "../assets/arrow-right.svg";
import { defaultLang, type Lang } from "../i18n/ui";
import { useTranslations, getPostHref } from "../i18n/utils";
import { getCollection, getEntry, type CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
const tags = post.data.tags;

const allPosts = (await getCollection("blog"))
  .filter((p) => p.id.startsWith(`${lang}/`))
  .sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
  );

const currentPostIndex = allPosts.findIndex((p) => p.id === post.id);
const olderPost = allPosts[currentPostIndex + 1];
const newerPost = allPosts[currentPostIndex - 1];

const sibling = post.data.translations
  ? await getEntry("blog", post.data.translations)
  : undefined;
const langSwitchHref = sibling ? getPostHref(sibling.id) : undefined;
---

<style>
  img {
    width: 100%;
  }
  p {
    margin: 0.25rem 0;
  }
  .post-header {
    border-bottom: 1px solid var(--bg4);
    margin: 0.5rem 0;
    padding-bottom: 0.5rem;
  }
  :global(.astro-code) {
    color: var(--fg);
    border-radius: var(--radius);
    border: 1px solid var(--bg1);
    padding: 1rem 1.5rem !important;
  }
  .pagination-container {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
  }
  @media only screen and (max-width: 600px) {
    .pagination-container {
      flex-direction: column;
    }
  }
  .pagination-link {
    padding: 1rem;
    flex: 1;
    border: 1px solid var(--bg3);
    border-radius: var(--radius);
    background-color: var(--bg1);
    transition: var(--transition);
  }
  .pagination-link > h4 {
    transition: var(--transition);
  }
  .pagination-link:hover {
    background-color: var(--bg2);
    text-decoration: none;
  }
  .pagination-link:hover > h4 {
    color: var(--accent);
  }
  :global(.pagination-link:hover .symbol-fg) {
    fill: var(--accent);
  }
  .pagination-link > h4 {
    margin: 0.25rem;
    color: var(--fg-dim);
  }
  .pagination-link-right {
    text-align: end;
  }
</style>

<BaseLayout
  pageTitle={post.data.title}
  langSwitchHref={langSwitchHref}
  langSwitchVisible={!!langSwitchHref}
>
  <div class="post-header">
    {
      post.data.image ? (
        <div class="banner-wrapper">
          <img
            class="banner-img"
            src={post.data.image.url}
            alt={post.data.image.alt}
          />
        </div>
      ) : null
    }
    <span class="post-date">
      {post.data.pubDate.toString().slice(0, 10)}
    </span>
    <p>
      {post.data.description}
    </p>
    <Tags tags={tags} />
  </div>
  <slot />
  <div class="pagination-container">
    {
      newerPost ? (
        <a href={getPostHref(newerPost.id)} class="pagination-link">
          <h4>
            <ArrowLeft /> {newerPost.data.title}
          </h4>
          <span class="post-date" style="margin-left: 1.5rem;">
            {t("post.newer")}
          </span>
        </a>
      ) : null
    }
    {
      olderPost ? (
        <a href={getPostHref(olderPost.id)} class="pagination-link pagination-link-right">
          <h4>
            {olderPost.data.title} <ArrowRight />
          </h4>
          <span class="post-date" style="margin-right: 1.5rem;">
            {t("post.older")}
          </span>
        </a>
      ) : null
    }
  </div>
</BaseLayout>