---
import RssIcon from "../assets/rss.svg";
import GitHubIcon from "../assets/github.svg";
---

<style>
  footer {
    display: flex;
    align-items: center;
    flex-direction: column;
    margin: 2rem;
    padding: 1rem;
    width: 100%;
    border-top: 1px solid var(--bg2);
  }
  p {
    margin: 0.5rem;
  }
  :global(.symbol-bg) {
    stroke: none;
    fill: var(--bg0);
  }
  :global(.symbol-fg) {
    fill: var(--fg);
  }

  .social:hover a,
  :global(.social:hover .symbol-fg) {
    fill: var(--accent);
  }
</style>

<footer>
  <p>
    <a href="http://github.com/joaolouceiro" class="social">
      GitHub <GitHubIcon /></a
    > |
    <a href="/rss.xml" class="social"> RSS <RssIcon /></a>
  </p>
  <p>©2026 João Louceiro</p>
</footer>
