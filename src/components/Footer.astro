---
import RssIcon from "../assets/rss.svg";
import GitHubIcon from "../assets/github.svg";
import { defaultLang, type Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";

const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<style>
  footer {
    display: flex;
    align-items: center;
    flex-direction: column;
    margin: 1rem;
    padding: 1rem;
    width: 100%;
    border-top: 1px solid var(--bg2);
  }
  p {
    margin: 0.5rem;
    color: var(--fg-dim);
  }
  :global(.symbol-bg) {
    stroke: none;
    fill: var(--bg0);
  }
  :global(.symbol-fg) {
    fill: var(--fg-dim);
    transition: var(--transition);
  }

  .social {
    color: var(--fg-dim);
    text-decoration: none;
  }

  .social:hover {
    color: var(--accent);
  }

  :global(.social:hover .symbol-fg),
  :global(.social:focus .symbol-fg) {
    fill: var(--accent);
  }
</style>

<footer>
  <p>
    <a href="http://github.com/joaolouceiro" class="social">
      GitHub <GitHubIcon /></a
    > |
    <a href="/rss.xml" class="social">
      RSS <RssIcon /></a
    >
  </p>
  <p>{t("footer.rights")}</p>
</footer>
