---
import ThemeIcon from "./ThemeIcon.astro";
---

<nav>
  <div class="main-box">
    <a href="/" class="nav-logo"
      >João <b style="color: var(--accent);">Louceiro</b></a
    >
    <div class="nav-links">
      <a href="/about/">About</a>
      <!-- <a href="/blog/">Blog</a> -->
      <!-- <a href="/tags/">Tags</a> -->
      <ThemeIcon />
    </div>
  </div>
</nav>

<style>
  nav {
    width: 100%;
    /* background: var(--bg0); */

    position: sticky;
    top: 0;
    z-index: 100;
    border-top: 4px solid var(--accent);
    border-bottom: 1px solid var(--bg2);
    padding: 0px;
    backdrop-filter: blur(16px);
  }
  .main-box {
    max-width: 90ch;
    width: 100%;
    padding: 1rem;
    margin: auto;
    display: flex;
    justify-content: space-between;
  }

  .nav-logo {
    text-decoration: none;
    color: var(--fg);
    font-family: var(--font-display);
    font-weight: bold;
    font-size: 1.3rem;
  }

  .nav-links {
    width: auto;
    text-align: center;
  }

  .nav-links a {
    display: inline-block;
    text-align: center;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: bold;
    color: var(--fg-dim);
    padding: 0px 10px;
  }

  a:hover,
  .nav-links a:hover {
    color: var(--accent);
  }
</style>
