---
import ThemeIcon from "./ThemeIcon.astro";
import LanguagePicker from "./LanguagePicker.astro";
import { defaultLang, type Lang } from "../i18n/ui";
import { useTranslations, getRelativeLocaleUrl } from "../i18n/utils";

interface Props {
  langSwitchHref?: string;
  langSwitchVisible?: boolean;
}

const { langSwitchHref, langSwitchVisible = true } = Astro.props;
const lang = (Astro.currentLocale ?? defaultLang) as Lang;
const t = useTranslations(lang);
---

<nav>
  <div class="main-box">
    <a href={getRelativeLocaleUrl(lang)} class="nav-logo"
      >João <b style="color: var(--accent);">Louceiro</b></a
    >
    <div class="nav-links">
      <a href=`${getRelativeLocaleUrl(lang, "/about")}`>{t("nav.about")}</a>
      <!-- <a href=`${getRelativeLocaleUrl(lang, "/blog")}`>{t("nav.blog")}</a> -->
      <!-- <a href=`${getRelativeLocaleUrl(lang, "/tags")}`>{t("nav.tags")}</a> -->
      <LanguagePicker href={langSwitchHref} visible={langSwitchVisible} />
      <ThemeIcon />
    </div>
  </div>
</nav>

<style>
  nav {
    width: 100%;
    /* background: var(--bg0); */

    position: sticky;
    top: 0;
    z-index: 100;
    border-top: 4px solid var(--accent);
    border-bottom: 1px solid var(--bg2);
    padding: 0px;
    backdrop-filter: blur(16px);
  }
  .main-box {
    max-width: 90ch;
    width: 100%;
    padding: 1rem;
    margin: auto;
    display: flex;
    justify-content: space-between;
  }

  .nav-logo {
    text-decoration: none;
    color: var(--fg);
    font-family: var(--font-display);
    font-weight: bold;
    font-size: 1.3rem;
  }

  .nav-links {
    width: auto;
    text-align: center;
  }

  .nav-links :global(a) {
    display: inline-block;
    text-align: center;
    text-decoration: none;
    font-size: 0.8rem;
    font-weight: bold;
    color: var(--fg-dim);
    padding: 0px 10px;
  }

  :global(.nav-links a:hover),
  .nav-links :global(a:hover) {
    color: var(--accent);
  }
</style>
